<Window x:Class="KeyTrail.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyTrail"
        Title="{DynamicResource App.Title}"
        Width="1240"
        Height="840"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="/KeyTrail;component/Assets/app.ico"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource UiFont}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource AccentSoft}">
                            <TextBlock Text="K" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KeyTrail" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{DynamicResource App.Title}" FontSize="10"
                                       Foreground="{DynamicResource TextFaint}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Margin="0,16,0,12" Padding="10,6" CornerRadius="10"
                            Background="{DynamicResource AccentSoft}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Positive}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource TextFaint}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,6,0,0">
                        <RadioButton x:Name="HomeRadio" Style="{StaticResource NavButton}"
                                     Content="{DynamicResource Nav.Home}"
                                     Tag="Home" GroupName="Nav"
                                     Checked="NavRadio_Checked" />
                        <RadioButton Style="{StaticResource NavButton}"
                                     Content="{DynamicResource Nav.History}"
                                     Tag="History" GroupName="Nav"
                                     Checked="NavRadio_Checked" />
                        <RadioButton Style="{StaticResource NavButton}"
                                     Content="{DynamicResource Nav.Insights}"
                                     Tag="Insights" GroupName="Nav"
                                     Checked="NavRadio_Checked" />
                        <RadioButton Style="{StaticResource NavButton}"
                                     Content="{DynamicResource Nav.Settings}"
                                     Tag="Settings" GroupName="Nav"
                                     Checked="NavRadio_Checked" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Button Content="{Binding StatusText}"
                            Command="{Binding ToggleRecordingCommand}"
                            Style="{StaticResource SoftButton}"
                            FontWeight="SemiBold" />
                    <TextBlock Margin="0,12,0,0"
                               Text="本地运行 · 不上传 · 不联网"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFaint}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding Current}"
                        Focusable="False" />
    </Grid>
</Window>

