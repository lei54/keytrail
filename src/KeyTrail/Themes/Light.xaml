<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBgColor">#F6F0E4</Color>
    <Color x:Key="CardBgColor">#FDF9F1</Color>
    <Color x:Key="CardBorderColor">#E9DFCC</Color>
    <Color x:Key="TextPrimaryColor">#2B2620</Color>
    <Color x:Key="TextSecondaryColor">#73695B</Color>
    <Color x:Key="TextFaintColor">#A99F90</Color>
    <Color x:Key="AccentColor">#4F6EF7</Color>
    <Color x:Key="AccentSoftColor">#DDE4FD</Color>
    <Color x:Key="PositiveColor">#3C9B5B</Color>
    <Color x:Key="NegativeColor">#C2503F</Color>
    <Color x:Key="NavHoverColor">#EFE6D3</Color>
    <Color x:Key="NavSelectedColor">#E4D8BE</Color>
    <Color x:Key="KeyCapColor">#F2EBDD</Color>
    <Color x:Key="KeyCapSideColor">#D8CDB8</Color>
    <Color x:Key="KeyTextColor">#3A352D</Color>
    <Color x:Key="KeyboardBaseColor">#E1D5BE</Color>
    <Color x:Key="ChartGridColor">#DDD3C0</Color>
    <Color x:Key="ChartSlot1Color">#3D5AF1</Color>
    <Color x:Key="ChartSlot2Color">#EFA94A</Color>
    <Color x:Key="ChartSlot3Color">#C95A8F</Color>
    <Color x:Key="ChartSlot4Color">#4BA6A2</Color>
    <Color x:Key="OverlayColor">#00000000</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="CardStyle" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextFaint" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="Positive" Color="{StaticResource PositiveColor}" />
    <SolidColorBrush x:Key="Negative" Color="{StaticResource NegativeColor}" />
    <SolidColorBrush x:Key="NavHover" Color="{StaticResource NavHoverColor}" />
    <SolidColorBrush x:Key="NavSelected" Color="{StaticResource NavSelectedColor}" />
    <SolidColorBrush x:Key="KeyCap" Color="{StaticResource KeyCapColor}" />
    <SolidColorBrush x:Key="KeyCapSide" Color="{StaticResource KeyCapSideColor}" />
    <SolidColorBrush x:Key="KeyText" Color="{StaticResource KeyTextColor}" />
    <SolidColorBrush x:Key="KeyboardBase" Color="{StaticResource KeyboardBaseColor}" />
    <SolidColorBrush x:Key="ChartGrid" Color="{StaticResource ChartGridColor}" />
    <SolidColorBrush x:Key="ChartSlot1" Color="{StaticResource ChartSlot1Color}" />
    <SolidColorBrush x:Key="ChartSlot2" Color="{StaticResource ChartSlot2Color}" />
    <SolidColorBrush x:Key="ChartSlot3" Color="{StaticResource ChartSlot3Color}" />
    <SolidColorBrush x:Key="ChartSlot4" Color="{StaticResource ChartSlot4Color}" />

    <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI, Yu Gothic UI</FontFamily>
</ResourceDictionary>

