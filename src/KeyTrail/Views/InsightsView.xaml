<UserControl x:Class="KeyTrail.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="InsightCard" TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <DataTemplate x:Key="ShareRow">
            <StackPanel Margin="0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" MinWidth="46"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding Label}" />
                    <TextBlock Grid.Column="2"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{Binding Count, StringFormat={}{0:N0}}" />
                </Grid>
                <ProgressBar Height="5" Margin="0,3,0,0" Maximum="1" Value="{Binding Share}"
                             Foreground="{DynamicResource Accent}"
                             Background="{DynamicResource CardBorder}"
                             BorderThickness="0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,10,12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource PageTitle}"
                           Text="{DynamicResource Insights.Title}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Style="{StaticResource BodyText}"
                           Text="{Binding DateText}" />
            </Grid>

            <UniformGrid Columns="3" Margin="0,12,0,0">
                <Border Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Insights.Presses}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding Presses}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Insights.AvgGap}"
                                   Style="{StaticResource BodyText}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding AverageGap}" />
                            <TextBlock Margin="5,9,0,0" VerticalAlignment="Bottom"
                                       FontSize="11" Foreground="{DynamicResource TextFaint}"
                                       Text="{DynamicResource Insights.Ms}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Insights.MedianGap}"
                                   Style="{StaticResource BodyText}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding MedianGap}" />
                            <TextBlock Margin="5,9,0,0" VerticalAlignment="Bottom"
                                       FontSize="11" Foreground="{DynamicResource TextFaint}"
                                       Text="{DynamicResource Insights.Ms}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Insights.Bursts}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding Bursts}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Insights.AvgBurst}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding AverageBurst}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Insights.ActiveMinutes}"
                                   Style="{StaticResource BodyText}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding ActiveMinutes}" />
                            <TextBlock Margin="5,9,0,0" VerticalAlignment="Bottom"
                                       FontSize="11" Foreground="{DynamicResource TextFaint}"
                                       Text="{DynamicResource Insights.Min}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Insights.ShortBreaks}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding ShortBreaks}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Insights.LongBreaks}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding LongBreaks}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Insights.LongestActive}"
                                   Style="{StaticResource BodyText}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="{Binding LongestActive}" />
                            <TextBlock Margin="5,9,0,0" VerticalAlignment="Bottom"
                                       FontSize="11" Foreground="{DynamicResource TextFaint}"
                                       Text="{DynamicResource Insights.Min}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InsightCard}"
                        Margin="0,12,10,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{DynamicResource Insights.Modifiers}" />
                        <ItemsControl ItemsSource="{Binding ModifierItems}"
                                      ItemTemplate="{StaticResource ShareRow}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InsightCard}"
                        Margin="2,12,10,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{DynamicResource Insights.Groups}" />
                        <ItemsControl ItemsSource="{Binding GroupItems}"
                                      ItemTemplate="{StaticResource ShareRow}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InsightCard}"
                        Margin="0,12,10,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{DynamicResource Insights.Weekday}" />
                        <ItemsControl ItemsSource="{Binding WeekdayItems}"
                                      ItemTemplate="{StaticResource ShareRow}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource InsightCard}"
                        Margin="2,12,10,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{DynamicResource Insights.Hotkeys}" />
                        <ItemsControl ItemsSource="{Binding ShortcutItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Padding="7,2" CornerRadius="5"
                                                Background="{DynamicResource AccentSoft}">
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Text="{Binding Count, StringFormat=×{}{0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

