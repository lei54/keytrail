<UserControl x:Class="KeyTrail.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:KeyTrail.Controls">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,10,12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource PageTitle}"
                           Text="{DynamicResource History.Title}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="4,3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DayRadio" Style="{StaticResource SegmentedButton}"
                                         Content="{DynamicResource History.Day}"
                                         GroupName="historyPeriod" Tag="Day"
                                         Checked="Period_Checked" />
                            <RadioButton x:Name="WeekRadio" Style="{StaticResource SegmentedButton}"
                                         Content="{DynamicResource History.Week}"
                                         GroupName="historyPeriod" Tag="Week"
                                         Checked="Period_Checked" />
                            <RadioButton x:Name="MonthRadio" Style="{StaticResource SegmentedButton}"
                                         Content="{DynamicResource History.Month}"
                                         GroupName="historyPeriod" Tag="Month"
                                         Checked="Period_Checked" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{Binding DateText}" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                               Style="{StaticResource BodyText}"
                               Text="{Binding RangeText}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="18,0,0,0">
                        <Button Content="‹" FontSize="16" Padding="12,4"
                                Style="{StaticResource SoftButton}"
                                Click="Previous_Click" />
                        <Button Content="›" FontSize="16" Padding="12,4" Margin="8,0,0,0"
                                Style="{StaticResource SoftButton}"
                                IsEnabled="{Binding CanGoNext}"
                                Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,16,0"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AllSlotRadio" Style="{StaticResource SegmentedButton}"
                                 Content="{DynamicResource History.All}"
                                 Tag="-1" GroupName="historySlot"
                                 Checked="Slot_Checked" />
                    <RadioButton Style="{StaticResource SegmentedButton}"
                                 Content="{DynamicResource Slot.Night}"
                                 Tag="0" GroupName="historySlot"
                                 Checked="Slot_Checked" />
                    <RadioButton Style="{StaticResource SegmentedButton}"
                                 Content="{DynamicResource Slot.Morning}"
                                 Tag="1" GroupName="historySlot"
                                 Checked="Slot_Checked" />
                    <RadioButton Style="{StaticResource SegmentedButton}"
                                 Content="{DynamicResource Slot.Noon}"
                                 Tag="2" GroupName="historySlot"
                                 Checked="Slot_Checked" />
                    <RadioButton Style="{StaticResource SegmentedButton}"
                                 Content="{DynamicResource Slot.Evening}"
                                 Tag="3" GroupName="historySlot"
                                 Checked="Slot_Checked" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="3" Margin="0,14,0,0">
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource History.Total}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding Total, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource History.PressPerDay}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding AveragePerDay, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource History.SlotShare}"
                                   Style="{StaticResource BodyText}" />
                        <ctrls:SegmentBar Height="18" Margin="0,12,0,0"
                                          Values="{Binding SlotCounts}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{DynamicResource History.HourCurve}" />
                            <ctrls:ActivityChart Height="190" Margin="0,10,0,0"
                                                 Values="{Binding HourValues}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{DynamicResource History.Trend}" />
                            <ctrls:ActivityChart Height="150" Margin="0,10,0,0"
                                                 Mode="Bars"
                                                 Values="{Binding DayValues}"
                                                 Labels="{Binding DayLabels}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{DynamicResource History.KeyboardHeat}" />
                            <ctrls:KeyboardHeatView Height="290" Margin="0,8,-14,0"
                                                    KeyCounts="{Binding Heat}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{DynamicResource History.SlotShare}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SlotItems[0].Label}"
                                               Style="{StaticResource BodyText}" />
                                    <TextBlock FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Text="{Binding SlotItems[0].Count, StringFormat={}{0:N0}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SlotItems[1].Label}"
                                               Style="{StaticResource BodyText}" />
                                    <TextBlock FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Text="{Binding SlotItems[1].Count, StringFormat={}{0:N0}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding SlotItems[2].Label}"
                                               Style="{StaticResource BodyText}" />
                                    <TextBlock FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Text="{Binding SlotItems[2].Count, StringFormat={}{0:N0}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{Binding SlotItems[3].Label}"
                                               Style="{StaticResource BodyText}" />
                                    <TextBlock FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Text="{Binding SlotItems[3].Count, StringFormat={}{0:N0}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
