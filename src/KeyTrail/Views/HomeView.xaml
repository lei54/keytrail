<UserControl x:Class="KeyTrail.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:KeyTrail.Controls">
    <UserControl.Resources>
        <Style x:Key="SectionBorder" TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,14,16,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,10,12">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}"
                       Text="{DynamicResource Nav.Home}" />

            <UniformGrid Columns="4">
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.TotalToday}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock Margin="0,6,0,0" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding TotalToday, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.YesterdayTotal}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding TotalYesterday, StringFormat={}{0:N0}}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding CompareText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.ActiveMinutes}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding ActiveMinutes, StringFormat={}{0:N0}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Home.CurrentSlot}"
                                   Style="{StaticResource BodyText}" />
                        <TextBlock Margin="0,6,0,0" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding CurrentSlotName}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding CurrentSlotShare}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{DynamicResource Home.KeyboardHeat}" />
                            <ctrls:KeyboardHeatView x:Name="HeatView"
                                                    Height="330"
                                                    Margin="0,8,-10,0"
                                                    KeyCounts="{Binding Heat}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{DynamicResource Home.CurveTitle}" />
                            <ctrls:ActivityChart Height="165"
                                                 Margin="0,10,0,0"
                                                 Values="{Binding HourValues}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}"
                        Margin="0,0,16,16"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{DynamicResource Home.TopKeys}" />
                        <ItemsControl ItemsSource="{Binding TopKeys}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Width="58"
                                                       Text="{Binding Label}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Count, StringFormat={}{0:N0}}"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Grid>
                                        <ProgressBar Height="6" Margin="0,4,0,0"
                                                     Maximum="1"
                                                     Minimum="0"
                                                     Value="{Binding Share}"
                                                     Foreground="{DynamicResource Accent}"
                                                     Background="{DynamicResource CardBorder}"
                                                     BorderThickness="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

